# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Database -----------------------------------------------------------------
# Vercel Postgres / Neon connection string (NFR: hosting + backup).
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Only needed if DATABASE_URL is a POOLED endpoint (PgBouncer / Neon pooler).
# Migrations run DDL, which a transaction pooler mishandles — point this at the
# unpooled host. Leave unset when DATABASE_URL is already a direct connection.
# DIRECT_DATABASE_URL="postgresql://user:password@direct-host/database?sslmode=require"

# --- Bootstrap admin (FR-9.1) -------------------------------------------------
# Read once, by the seed, to create the single Admin account that can then invite
# others. There is no public sign-up. Change the password after first sign-in;
# the seed never overwrites an existing account's password.
BOOTSTRAP_ADMIN_EMAIL="you@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-long-random-password"
