{
  "name": "portfolio-tracker",
  "version": "0.1.0",
  "description": "Quarterly portfolio ledger — per-holding tracking, targets, and drift.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:constraints": "node scripts/apply-constraints.mjs",
    "db:setup": "prisma migrate dev && npm run db:constraints && npm run db:seed",
    "db:import": "tsx prisma/import.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "next": "^16.2.12",
    "pg": "8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "17.2.3",
    "postcss": "^8.5.25",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "^6.0.3"
  }
}
